# MNC LifeStyle - Environment Configuration
# Copy this file to .env.local and update with your real credentials
# NEVER commit .env or .env.local to version control!

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.rg5mkrz.mongodb.net/mnc_lifestyle?retryWrites=true&w=majority

# Cloudinary Media Storage (Format: cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# JWT Authentication Secret (Minimum 32 characters, generate with: openssl rand -base64 32)
AUTH_SECRET=your_super_secret_jwt_and_session_key_min_32_chars

# Initial Admin Credentials (Used for database seed/test scripts)
ADMIN_EMAIL=admin@mnclifestyle.in
ADMIN_INITIAL_PASSWORD=your_initial_secure_admin_password

# Public Site URL (Used for OpenGraph metadata and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://mnclifestyle.in
